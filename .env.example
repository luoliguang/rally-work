# PostgreSQL — 在宝塔面板里创建数据库后填入
DATABASE_URL=postgresql://rally_user:your_password@localhost:5432/rally_db

# 管理员密码 — 用于 /admin 页面登录和评论审核
ADMIN_PASSWORD=change_this_to_a_strong_password

# 监听端口 — 服务器端口冲突时改这里即可（PM2 会读取并注入）。本地默认 3001。
# 改完别忘了把 Nginx 反向代理的目标端口也改成一致。
PORT=3001

# 上传目录（可选）——默认就是项目内的 public/uploads，本地和服务器都自动适配，
# 一般无需设置。只有当你想把文件存到项目外（例如交给 nginx 托管的独立目录）时才填，
# 相对路径会基于项目根解析，绝对路径直接使用。
# UPLOAD_DIR=
